# 資料來源：local（瀏覽器本機，單人單裝置）、memory（示範／測試）、firestore（即時共編）
VITE_DATA=local

# 下面只有 VITE_DATA=firestore 時才需要。
# 到 Firebase Console → 專案設定 → 一般 → 你的應用程式，複製這些值。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 本機用 Firebase Emulator 測試時設為 1
VITE_USE_EMULATOR=
